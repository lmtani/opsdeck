# Copy to .env and adjust. Every value is optional.

# Host port for the dashboard (http://127.0.0.1:8765)
OPSDECK_PORT=8765

# Root password of the bundled MySQL
MYSQL_ROOT_PASSWORD=opsdeck

# Token for the GitHub tab: the output of `gh auth token`, or a classic personal
# access token with the `repo` and `read:org` scopes. Unset disables the tab.
# GITHUB_TOKEN=
